+        private static void CopyLInfoToNest(NovaLineServices.LsLInfo source, out LsLInfo target)
+        {
+            target = default;
+            target.dvpAscent = source.dvpAscent;
+            target.dvrAscent = source.dvrAscent;
+            target.dvpDescent = source.dvpDescent;
+            target.dvrDescent = source.dvrDescent;
+            target.dvpMultiLineHeight = source.dvpMultiLineHeight;
+            target.dvrMultiLineHeight = source.dvrMultiLineHeight;
+            target.dvpAscentAutoNumber = source.dvpAscentAutoNumber;
+            target.dvrAscentAutoNumber = source.dvrAscentAutoNumber;
+            target.dvpDescentAutoNumber = source.dvpDescentAutoNumber;
+            target.dvrDescentAutoNumber = source.dvrDescentAutoNumber;
+            target.cpLimToContinue = source.cpLimToContinue;
+            target.cpLimToStay = source.cpLimToStay;
