+        /// <summary>
+        /// Adapts the WPF <c>DrawTextRun</c> delegate to the Nova.LineServices signature by
+        /// field-copying the shared layout structs (LSPOINT / LsHeights / LSRECT) in and out.
+        /// A managed trampoline (not a function pointer) is required: the engine cannot
+        /// <c>GetDelegateForFunctionPointer</c> a thunk created from the WPF delegate type
+        /// (InvalidCastException), and a direct delegate cast across the two distinct types is
+        /// not ABI-safe. The trampoline is kept alive by the engine's copied context info.
+        /// </summary>
+        private static unsafe NovaLineServices.DrawTextRun CreateDrawTextRunTrampoline(LsContextInfo client)
+        {
+            return delegate (
+                IntPtr pols,
+                NovaLineServices.Plsrun plsrun,
+                ref NovaLineServices.LSPOINT ptText,
+                char* runText,
+                int* charWidths,
+                int cchText,
+                NovaLineServices.LsTFlow textFlow,
+                uint displayMode,
+                ref NovaLineServices.LSPOINT ptRun,
+                ref NovaLineServices.LsHeights lsHeights,
+                int dupRun,
+                ref NovaLineServices.LSRECT clipRect)
+            {
+                LSPOINT nestPtText = default;
+                nestPtText.x = ptText.x;
+                nestPtText.y = ptText.y;
+                LSPOINT nestPtRun = default;
+                nestPtRun.x = ptRun.x;
+                nestPtRun.y = ptRun.y;
+                LsHeights nestHeights = default;
+                nestHeights.dvAscent = lsHeights.dvAscent;
+                nestHeights.dvDescent = lsHeights.dvDescent;
+                nestHeights.dvMultiLineHeight = lsHeights.dvMultiLineHeight;
+                LSRECT nestClipRect = default;
+                nestClipRect.left = clipRect.left;
+                nestClipRect.top = clipRect.top;
+                nestClipRect.right = clipRect.right;
+                nestClipRect.bottom = clipRect.bottom;
+
+                LsErr err = client.pfnDrawTextRun(
+                    pols,
+                    (Plsrun)plsrun,
+                    ref nestPtText,
+                    runText,
+                    charWidths,
+                    cchText,
+                    (LsTFlow)textFlow,
+                    displayMode,
+                    ref nestPtRun,
+                    ref nestHeights,
+                    dupRun,
+                    ref nestClipRect);
+
+                ptText.x = nestPtText.x;
+                ptText.y = nestPtText.y;
+                ptRun.x = nestPtRun.x;
+                ptRun.y = nestPtRun.y;
+                lsHeights.dvAscent = nestHeights.dvAscent;
+                lsHeights.dvDescent = nestHeights.dvDescent;
+                lsHeights.dvMultiLineHeight = nestHeights.dvMultiLineHeight;
+                clipRect.left = nestClipRect.left;
+                clipRect.top = nestClipRect.top;
+                clipRect.right = nestClipRect.right;
+                clipRect.bottom = nestClipRect.bottom;
+
+                return (NovaLineServices.LsErr)err;
+            };
+        }
