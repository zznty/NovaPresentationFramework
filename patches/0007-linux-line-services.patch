+
+        private static unsafe LsErr LoSetTabsLinux(
+            IntPtr ploc,
+            int durIncrementalTab,
+            int tabCount,
+            LsTbd* pTabs)
+        {
+            if (tabCount <= 0)
+            {
+                return (LsErr)NovaLineServices.LoExports.LoSetTabs(ploc, durIncrementalTab, tabCount, null);
+            }
+
+            NovaLineServices.LsTbd[] novaTabs = new NovaLineServices.LsTbd[tabCount];
+            for (int i = 0; i < tabCount; i++)
+            {
+                novaTabs[i].lskt = (NovaLineServices.LsKTab)pTabs[i].lskt;
+                novaTabs[i].ur = pTabs[i].ur;
+                novaTabs[i].wchTabLeader = pTabs[i].wchTabLeader;
+                novaTabs[i].wchCharTab = pTabs[i].wchCharTab;
+            }
+
+            fixed (NovaLineServices.LsTbd* pNovaTabs = novaTabs)
+            {
+                return (LsErr)NovaLineServices.LoExports.LoSetTabs(ploc, durIncrementalTab, tabCount, pNovaTabs);
+            }
+        }
+
