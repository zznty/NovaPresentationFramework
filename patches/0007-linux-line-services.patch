+        //
+        //  Linux managed Line Services (Nova.LineServices)
+        //
+        //  PresentationNative_cor3.dll does not exist on Linux. The Lo* methods above field-copy
+        //  the nest structs into the Nova.LineServices structs (identical sequential layout, but
+        //  LsContextInfo's typed callback delegates become pointer-sized slots) and call the
+        //  isolated managed engine. WPF's own delegates stay WPF types and are driven through
+        //  trampolines that adapt LsPap / LsLineProps / LsChp / LsTxM field-by-field; nothing is
+        //  reinterpret-cast, so the typed callback table in LsContextInfo is never corrupted.
+        //  pols is passed through unchanged: like the native API, Nova fills the context's pols
+        //  with the context handle and passes that handle to the callbacks.
+        //
+
+        private static unsafe LsErr LoCreateContextLinux(
+            ref LsContextInfo contextInfo,
+            ref LscbkRedefined lscbkRedef,
+            out IntPtr ploc)
+        {
+            LsContextInfo client = contextInfo;
+            LscbkRedefined clientRedef = lscbkRedef;
+
+            NovaLineServices.LsContextInfo info = default;
+            NovaLineServices.FetchLineProps fetchLinePropsTrampoline =
+                (pols, lscpFetch, firstLineInPara, ref lsLineProps) =>
+                    FetchLinePropsTrampoline(client, pols, lscpFetch, firstLineInPara, ref lsLineProps);
+            CopyContextInfoToNova(client, fetchLinePropsTrampoline, ref info);
