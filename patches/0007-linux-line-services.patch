+            IntPtr ploline,
+            ref LSPOINT ptQuery,
+            int depthQueryMax,
+            IntPtr pSubLineInfo,
+            out int actualDepthQuery,
+            out LsTextCell lsTextCell)
+        {
+            NovaLineServices.LSPOINT novaPt = default;
