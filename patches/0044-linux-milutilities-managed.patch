+        /// <summary>
+        /// Managed replacement for milcore's MilUtility_CopyPixelBuffer on the Linux host
+        /// (patch 0044): the pixel math lives in Nova.Imaging.PixelBufferUtility; this
+        /// wrapper only adapts the raw pointers at the boundary.
+        /// </summary>
+        internal static unsafe void MILCopyPixelBuffer(
+            byte *  pOutputBuffer,
+            uint    outputBufferSize,
+            uint    outputBufferStride,
+            uint    outputBufferOffsetInBits,
+            byte *  pInputBuffer,
+            uint    inputBufferSize,
+            uint    inputBufferStride,
+            uint    inputBufferOffsetInBits,
+            uint    height,
+            uint    copyWidthInBits
+            )
+        {
+            if (OperatingSystem.IsWindows())
+            {
+                MILCopyPixelBufferCore(
+                    pOutputBuffer,
+                    outputBufferSize,
+                    outputBufferStride,
+                    outputBufferOffsetInBits,
+                    pInputBuffer,
+                    inputBufferSize,
+                    inputBufferStride,
+                    inputBufferOffsetInBits,
+                    height,
+                    copyWidthInBits);
+                return;
+            }
+
+            Nova.Imaging.PixelBufferUtility.CopyPixels(
+                new Span<byte>(pOutputBuffer, checked((int)outputBufferSize)),
+                outputBufferStride,
+                outputBufferOffsetInBits,
+                new ReadOnlySpan<byte>(pInputBuffer, checked((int)inputBufferSize)),
+                inputBufferStride,
+                inputBufferOffsetInBits,
+                height,
+                copyWidthInBits);
+        }
