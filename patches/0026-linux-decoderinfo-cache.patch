+                {
+                    // WIC two-call convention: first call (cchMimeTypes == 0) reports the
+                    // required length including the null terminator; the second fills the
+                    // caller's buffer.
+                    pcchActual = checked((UInt32)info.MimeTypes.Length + 1);
+                    if (wzMimeTypes != null && cchMimeTypes >= pcchActual)
+                    {
+                        _ = wzMimeTypes.Append(info.MimeTypes);
+                    }
+
+                    return 0; // S_OK
+                }
+
+                pcchActual = 0;
+                return unchecked((int)0x80004003); // E_POINTER
+            }
