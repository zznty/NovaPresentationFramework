+        internal Font GetFirstMatchingFont(FontWeight weight, FontStretch stretch, FontStyle style)
+        {
+            Font best = null;
+            int bestScore = int.MaxValue;
+            foreach (Font font in this)
+            {
+                int score = Math.Abs((int)font.Weight - (int)weight)
+                    + Math.Abs((int)font.Stretch - (int)stretch)
+                    + Math.Abs((int)font.Style - (int)style);
+                if (score < bestScore)
+                {
+                    bestScore = score;
+                    best = font;
+                }
+            }
+
+            return best ?? this[0];
+        }
+
+        internal FontList GetMatchingFonts(FontWeight weight, FontStretch stretch, FontStyle style)
+        {
+            var list = new FontList { FontsCollection = FontsCollection };
+            list.Add(GetFirstMatchingFont(weight, stretch, style));
+            return list;
+        }
