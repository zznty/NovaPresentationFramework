+        internal unsafe void GetGlyphs(
+            char* textString,
+            uint textLength,
+            Font font,
+            ushort blankGlyphIndex,
+            bool isSideways,
+            bool isRightToLeft,
+            CultureInfo cultureInfo,
+            DWriteFontFeature[][] features,
+            uint[] featureRangeLengths,
+            uint maxGlyphCount,
+            TextFormattingMode textFormattingMode,
+            ItemProps itemProps,
+            ushort* clusterMap,
+            ushort* textProps,
+            ushort* glyphIndices,
+            uint* glyphProps,
+            int* pfCanGlyphAlone,
+            out uint actualGlyphCount)
+        {
+            _ = blankGlyphIndex;
+            _ = isSideways;
+            _ = features;
+            _ = featureRangeLengths;
+            _ = textFormattingMode;
+            _ = itemProps;
+            Shape(
+                textString,
+                textLength,
+                font,
+                isRightToLeft,
+                cultureInfo,
+                fontEmSize: 16,
+                scalingFactor: 1,
+                out ushort[] clusters,
+                out ushort[] glyphs,
+                out _,
+                out _);
+            actualGlyphCount = (uint)glyphs.Length;
+            if (actualGlyphCount > maxGlyphCount)
