+        private static unsafe void Shape(
+            char* textString,
+            uint textLength,
+            Font font,
+            bool isRightToLeft,
+            CultureInfo cultureInfo,
+            double fontEmSize,
+            double scalingFactor,
+            out ushort[] clusterMap,
+            out ushort[] glyphIndices,
+            out int[] glyphAdvances,
+            out GlyphOffset[] glyphOffsets)
+        {
+            var text = new string(textString, 0, (int)textLength);
+            FontFace face = font.GetFontFace();
+            Nova.FreeType.FontFace native = face.Native;
+            native.SetPixelSize(fontEmSize > 0 ? fontEmSize : 16);
+            using var shaper = new HarfBuzzShaper(native);
+            string language = cultureInfo?.TwoLetterISOLanguageName ?? "en";
+            var options = new ShapeOptions(language, "Latn", isRightToLeft);
+            Span<ShapedGlyph> shaped = text.Length <= 1024
+                ? stackalloc ShapedGlyph[1024]
+                : new ShapedGlyph[text.Length * 2];
+            int count = shaper.Shape(text, options, shaped);
+            clusterMap = new ushort[text.Length];
+            glyphIndices = new ushort[count];
+            glyphAdvances = new int[count];
+            glyphOffsets = new GlyphOffset[count];
+            double scale = scalingFactor <= 0 ? 1 : scalingFactor;
+            for (int i = 0; i < count; i++)
+            {
+                ShapedGlyph item = shaped[i];
+                glyphIndices[i] = (ushort)item.GlyphIndex;
+                glyphAdvances[i] = (int)Math.Round(item.Advance.Width * scale);
+                glyphOffsets[i] = new GlyphOffset
+                {
+                    du = (int)Math.Round(item.Offset.X * scale),
+                    dv = (int)Math.Round(item.Offset.Y * scale)
+                };
+                int cluster = (int)Math.Min(item.Cluster, (uint)Math.Max(0, text.Length - 1));
+                if (cluster < clusterMap.Length)
+                {
+                    clusterMap[cluster] = (ushort)i;
+                }
+            }
+
+            ushort last = 0;
+            for (int i = 0; i < clusterMap.Length; i++)
+            {
+                if (i > 0 && clusterMap[i] == 0 && last != 0)
+                {
+                    clusterMap[i] = last;
+                }
+                else if (clusterMap[i] != 0 || i == 0)
+                {
+                    last = clusterMap[i];
+                }
+            }
+        }
