+        internal static FontMetrics ToFontMetrics(FontFaceMetrics metrics)
+        {
+            ushort units = (ushort)Math.Clamp(metrics.UnitsPerEm, 1, ushort.MaxValue);
+            return new FontMetrics
+            {
+                DesignUnitsPerEm = units,
+                Ascent = ToUShort(metrics.Ascent),
+                Descent = ToUShort(Math.Abs(metrics.Descent)),
+                LineGap = (short)Math.Clamp(metrics.LineGap, short.MinValue, short.MaxValue),
+                CapHeight = ToUShort(metrics.Ascent * 0.7),
+                XHeight = ToUShort(metrics.Ascent * 0.5),
+                UnderlinePosition = (short)(-units / 8),
+                UnderlineThickness = (ushort)Math.Max(1, units / 14),
+                StrikethroughPosition = ToShort(metrics.Ascent * 0.3),
