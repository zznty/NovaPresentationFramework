+    internal sealed class FontCollection
+    {
+        private readonly Factory _factory;
+        private readonly List<FontFamily> _families = [];
+        private readonly Dictionary<string, uint> _indexByName = new(StringComparer.OrdinalIgnoreCase);
+
+        internal unsafe FontCollection(Native.IDWriteFontCollection* fontCollection)
+        {
+            _ = fontCollection;
+        }
+
+        private FontCollection(Factory factory)
+        {
+            _factory = factory;
+        }
+
+        internal uint FamilyCount => (uint)_families.Count;
+
+        internal FontFamily this[uint familyIndex] => _families[(int)familyIndex];
+
+        internal FontFamily this[string familyName]
+        {
+            get
+            {
+                return FindFamilyName(familyName, out uint index) ? _families[(int)index] : TryAddFamily(familyName);
+            }
+        }
+
+        internal bool FindFamilyName(string familyName, out uint index)
+        {
+            return _indexByName.TryGetValue(familyName, out index);
+        }
+
+        internal Font GetFontFromFontFace(FontFace fontFace)
+        {
+            string path = fontFace.GetFileZero().GetUriPath();
+            foreach (FontFamily family in _families)
+            {
+                foreach (Font font in family)
+                {
+                    if (string.Equals(font.GetFontFace().GetFileZero().GetUriPath(), path, StringComparison.OrdinalIgnoreCase)
+                        && font.GetFontFace().Index == fontFace.Index)
+                    {
+                        return font;
+                    }
+                }
+            }
+
+            return _families[0][0];
+        }
+
+        internal static FontCollection CreateSystem(Factory factory)
+        {
+            var collection = new FontCollection(factory);
+            Span<string> names = new string[2048];
+            int count = factory.FontConfig.ListFamilies(names);
+            for (int i = 0; i < count; i++)
+            {
+                string familyName = names[i];
+                try
+                {
+                    FontMatch match = factory.FontConfig.Match(new FontQuery(familyName));
+                    Nova.FreeType.FontFace native = factory.FreeType.OpenFace(match.FilePath, match.FaceIndex);
+                    FontMetrics metrics = FontFace.ToFontMetrics(native.Metrics);
+                    var family = new FontFamily(familyName, metrics) { FontsCollection = collection };
+                    family.Add(new Font(factory, family, match, native));
+                    collection.AddFamily(family);
+                }
+                catch (FontConfigException)
+                {
+                }
+                catch (FreeTypeException)
+                {
+                }
+            }
+
+            return collection;
+        }
+
+        internal static FontCollection CreateFromDirectory(Factory factory, string directory)
+        {
+            var collection = new FontCollection(factory);
+            foreach (string path in Directory.EnumerateFiles(directory))
+            {
+                string ext = Path.GetExtension(path);
+                if (!ext.Equals(".ttf", StringComparison.OrdinalIgnoreCase)
+                    && !ext.Equals(".otf", StringComparison.OrdinalIgnoreCase)
+                    && !ext.Equals(".ttc", StringComparison.OrdinalIgnoreCase))
+                {
+                    continue;
+                }
+
+                try
+                {
+                    Nova.FreeType.FontFace native = factory.FreeType.OpenFace(path, 0);
+                    var match = new FontMatch(native.FamilyName, path, 0, 80, 0, 100);
+                    FontFamily family = collection.FindFamilyName(native.FamilyName, out uint index)
+                        ? collection[index]
+                        : null;
+                    if (family == null)
+                    {
+                        family = new FontFamily(native.FamilyName, FontFace.ToFontMetrics(native.Metrics))
+                        {
+                            FontsCollection = collection
+                        };
+                        collection.AddFamily(family);
+                    }
+
+                    family.Add(new Font(factory, family, match, native));
+                }
+                catch (FreeTypeException)
+                {
+                }
+            }
+
+            return collection;
+        }
+
+        private void AddFamily(FontFamily family)
+        {
+            uint index = (uint)_families.Count;
+            _families.Add(family);
+            _indexByName[family.OrdinalName] = index;
+        }
+
+        private FontFamily TryAddFamily(string familyName)
+        {
+            if (_factory == null || string.IsNullOrEmpty(familyName))
+            {
+                return null;
+            }
+
+            try
+            {
+                FontMatch match = _factory.FontConfig.Match(new FontQuery(familyName));
+                Nova.FreeType.FontFace native = _factory.FreeType.OpenFace(match.FilePath, match.FaceIndex);
+                var family = new FontFamily(familyName, FontFace.ToFontMetrics(native.Metrics))
+                {
+                    FontsCollection = this
+                };
+                family.Add(new Font(_factory, family, match, native));
+                AddFamily(family);
+                return family;
+            }
+            catch (FontConfigException)
+            {
+                return null;
+            }
+            catch (FreeTypeException)
+            {
+                return null;
+            }
+        }
+    }
