+        private static GlyphMetrics ToDWriteMetrics(Nova.FreeType.GlyphMetrics metrics)
+        {
+            int left = (int)Math.Round(metrics.Bounds.X);
+            int width = (int)Math.Round(metrics.Bounds.Width);
+            int height = (int)Math.Round(metrics.Bounds.Height);
+            int advanceWidth = (int)Math.Round(metrics.Advance.Width);
+            int advanceHeight = (int)Math.Round(metrics.Advance.Height);
+            int top = (int)Math.Round(metrics.Bounds.Y);
+            return new GlyphMetrics
+            {
+                LeftSideBearing = left,
+                AdvanceWidth = (uint)Math.Max(0, advanceWidth),
+                RightSideBearing = advanceWidth - left - width,
+                TopSideBearing = top,
+                AdvanceHeight = (uint)Math.Max(0, advanceHeight),
+                BottomSideBearing = advanceHeight - height - top,
+                VerticalOriginY = top + height
+            };
+        }
