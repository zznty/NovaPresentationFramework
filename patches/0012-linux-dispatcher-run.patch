+                    s_linuxEventLoopPresent?.Invoke();
+                }
+
+                // Block for input (or a timer/wake) instead of busy-polling.
+                // Negative = wait until an SDL event or a cross-thread wake.
+                int waitMs = ComputeLinuxWaitTimeout();
+                bool keepRunning = s_linuxEventLoopStep is { } step
+                    ? step(waitMs)
+                    : LinuxDefaultWait(waitMs);
