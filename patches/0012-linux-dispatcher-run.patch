+        /// <summary>
+        /// Host-registered Linux message-loop hooks, injected by Nova.SdlSource at
+        /// type-load (WindowsBase cannot reference the SDL host — reference cycle).
+        /// Single-UI-thread assumption: these are process-wide statics, so a second
+        /// Dispatcher on another thread would share them. That matches the SDL model
+        /// (one event queue, one pump thread) and is the supported v1 shape.
+        /// </summary>
+        private static Func<int, bool> s_linuxEventLoopStep;
+        private static Action s_linuxEventLoopPresent;
+        private static Action s_linuxWakeSignal;
+
+        internal static void RegisterLinuxEventLoop(Func<int, bool> step, Action present, Action wake)
+        {
+            s_linuxEventLoopStep = step;
+            s_linuxEventLoopPresent = present;
+            s_linuxWakeSignal = wake;
+        }
+
+        private void RunLinuxMessageLoop(DispatcherFrame frame)
+        {
+            while (frame.Continue)
+            {
+                // DispatcherTimer promotion is normally driven by a WM_TIMER on
+                // the message-only window. On Linux there is no timer window, so
+                // due timers are promoted here (PromoteTimers raises a due timer's
+                // Inactive-priority operation to its configured priority).
+                PromoteTimers(Environment.TickCount);
+
+                // Run every queued operation and remember whether any
+                // Render-priority+ work ran. MediaContext schedules its render
+                // pass at Render priority, so that is the only signal that a frame
+                // should be presented — an idle app runs no render ops and
+                // presents nothing.
+                bool rendered = DrainLinuxQueue();
