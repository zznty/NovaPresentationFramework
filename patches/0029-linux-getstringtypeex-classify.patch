+++ b/src/Microsoft.DotNet.Wpf/src/Shared/MS/Win32/SafeNativeMethodsOther.cs
@@ -107,6 +107,15 @@ public static int GetCaretBlinkTime()
 
         public static unsafe bool GetStringTypeEx(uint locale, uint infoType, ReadOnlySpan<char> sourceString, Span<ushort> charTypes)
         {
+            if (!OperatingSystem.IsWindows())
+            {
+                // The Win32 character-type tables classify per CT_CTYPE1/2/3; classify via
+                // the ICU-backed Nova.Classification tables so word breaking
+                // (SelectionWordBreaker) works on Linux.
+                Nova.Classification.CharTypeClassifier.GetStringType(infoType, sourceString, charTypes);
+                return true;
+            }
+
             // Since we do not use [LibraryImport], Span<T> marshallers are not available by default
             fixed (char* ptrSourceString = sourceString)
             fixed (ushort* ptrCharTypes = charTypes)
