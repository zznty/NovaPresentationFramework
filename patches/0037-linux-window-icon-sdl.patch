+        /// <summary>
+        ///  The SDL-backed window icon (Linux): decodes the ImageSource to BGRA rows and
+        ///  hands them to SDL_SetWindowIcon (the Win32 WM_SETICON/ExtractIconEx path has no
+        ///  Linux host). Compositors may ignore the request — Wayland has no universal
+        ///  window-icon surface — but SDL forwards it where supported. A null icon resets
+        ///  the window to no icon.
+        /// </summary>
+        private void UpdateIconLinux()
+        {
+            if (PresentationSource.FromVisual(this) is not Nova.SdlSource.SdlPresentationSource source)
+            {
+                return;
+            }
+
+            if (_icon is null)
+            {
+                // No icon: clear any previously set one.
+                source.SetWindowIcon(0, 0, 0, []);
+                return;
+            }
+
+            try
+            {
+                BitmapSource bitmap = _icon as BitmapSource ?? RenderIconToBitmap(_icon);
+                const int maxDimension = 256;
+                int width = Math.Clamp(bitmap.PixelWidth, 1, maxDimension);
+                int height = Math.Clamp(bitmap.PixelHeight, 1, maxDimension);
+                FormatConvertedBitmap converted = new(bitmap, PixelFormats.Bgra32, null, 0);
+                int stride = converted.PixelWidth * 4;
+                byte[] pixels = new byte[stride * converted.PixelHeight];
+                converted.CopyPixels(pixels, stride, 0);
+                source.SetWindowIcon(converted.PixelWidth, converted.PixelHeight, stride, pixels);
+            }
+            catch (Exception e) when (e is ArgumentException or NotSupportedException)
+            {
+                // An undecodable icon source degrades to no icon.
+            }
+        }
+
+        private static BitmapSource RenderIconToBitmap(ImageSource image)
+        {
+            var visual = new DrawingVisual();
+            using (DrawingContext context = visual.RenderOpen())
+            {
+                context.DrawImage(image, new Rect(0, 0, 32, 32));
+            }
+
+            var bitmap = new RenderTargetBitmap(32, 32, 96, 96, PixelFormats.Pbgra32);
+            bitmap.Render(visual);
+            return bitmap;
+        }
+
