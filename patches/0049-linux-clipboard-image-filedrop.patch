+        byte[] pixels = new byte[stride * bgra.PixelHeight];
+        bgra.CopyPixels(pixels, stride, 0);
+        byte[] png = Nova.Imaging.PngCodec.EncodeBgra32(bgra.PixelWidth, bgra.PixelHeight, pixels);
+        Nova.Sdl.SdlHost.SetClipboardData(new Dictionary<string, byte[]> { ["image/png"] = png });
