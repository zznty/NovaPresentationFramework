+    // Linux host (patch 0049): the file list travels as the XDG "text/uri-list" mime
+    // (file:// URIs, CRLF separated) through the SDL clipboard.
+    private static StringCollection GetFileDropListLinux()
+    {
+        StringCollection result = [];
+
+        byte[]? uriList = Nova.Sdl.SdlHost.GetClipboardData("text/uri-list");
+        if (uriList is null)
+        {
+            return result;
+        }
+
+        string text = System.Text.Encoding.UTF8.GetString(uriList);
+        foreach (string line in text.Split(["\r\n", "\n"], StringSplitOptions.RemoveEmptyEntries))
+        {
+            if (Uri.TryCreate(line.Trim(), UriKind.Absolute, out Uri? uri) && uri.IsFile)
+            {
+                result.Add(uri.LocalPath);
+            }
+        }
+
+        return result;
+    }
