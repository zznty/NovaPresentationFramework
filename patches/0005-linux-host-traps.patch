+        private static unsafe bool PolygonFillContains(Point* points, uint pointCount, Point hitPoint, Transform transform)
+        {
+            if (pointCount < 3)
+            {
+                return false;
+            }
+
+            if (transform != null && !transform.IsIdentity)
+            {
+                Matrix matrix = transform.Value;
+                if (!matrix.HasInverse)
+                {
+                    return false;
+                }
+
+                matrix.Invert();
+                hitPoint = matrix.Transform(hitPoint);
+            }
+
+            int winding = 0;
+            Point previous = points[pointCount - 1];
+            for (uint i = 0; i < pointCount; i++)
+            {
+                Point current = points[i];
+                if ((previous.Y <= hitPoint.Y && current.Y > hitPoint.Y) ||
+                    (previous.Y > hitPoint.Y && current.Y <= hitPoint.Y))
+                {
+                    double x = previous.X + ((hitPoint.Y - previous.Y) * (current.X - previous.X) / (current.Y - previous.Y));
+                    if (hitPoint.X < x)
+                    {
+                        winding++;
+                    }
+                }
+
+                previous = current;
+            }
+
+            return (winding & 1) != 0;
