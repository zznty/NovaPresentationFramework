         #region Internal Methods
 
+        /// <summary>
+        ///  The Linux dialog runner: starts the SDL dialog (the XDG Desktop Portal), pumps a
+        ///  nested dispatcher frame until it completes, then applies the managed state — the
+        ///  item names and the FileOk cancellation hook. Returns the session on success so
+        ///  the concrete dialog can post-process; <see langword="null"/> on error, cancel, or
+        ///  a canceled FileOk.
+        /// </summary>
+        private protected Nova.SdlSource.FileDialogSession? ShowDialogLinuxCore(
+            Nova.SdlSource.FileDialogKind kind,
+            Nova.SdlSource.FileDialogFilter[]? filters,
+            bool allowMany)
+        {
+            Nova.SdlSource.SdlPresentationSource? source = Nova.SdlSource.SdlPresentationSource.FromActiveWindow();
+            if (source is null)
+            {
+                // No window exists to own the dialog (and no event pump to finish it).
+                return null;
+            }
+
+            Nova.SdlSource.FileDialogSession session = source.ShowFileDialog(
+                kind,
+                filters,
+                InitialDirectory,
+                allowMany);
+
+            // The SDL dialog is asynchronous: keep a nested dispatcher frame running until
+            // the callback fires. The callback may run on any thread; marshal the frame's
+            // exit to the UI thread (a same-thread BeginInvoke executes inline).
+            var frame = new DispatcherFrame();
+            session.Completed += (_, _) =>
+                Dispatcher.CurrentDispatcher.BeginInvoke(DispatcherPriority.Send, (Action)(() => frame.Continue = false));
+            Dispatcher.PushFrame(frame);
+
+            if (session.FileNames is null || session.FileNames.Count == 0)
+            {
+                return null;
+            }
+
+            // The managed FileOk/Cancel hook: an app can refuse the selection.
+            var cancelArgs = new CancelEventArgs();
+            OnItemOk(cancelArgs);
+            if (cancelArgs.Cancel)
+            {
+                return null;
+            }
+
+            MutableItemNames = [.. session.FileNames];
+            return session;
+        }
+
+
