+        /// <summary>
+        ///  The Linux runner: maps the Open/Save specifics to the SDL dialog and applies the
+        ///  managed post-processing the Windows dialog performs after the user picks.
+        /// </summary>
+        internal bool? ShowDialogLinux()
+        {
+            bool isSave = this is SaveFileDialog;
+            Nova.SdlSource.FileDialogKind kind = isSave
+                ? Nova.SdlSource.FileDialogKind.Save
+                : Nova.SdlSource.FileDialogKind.Open;
+            bool allowMany = this is OpenFileDialog { Multiselect: true };
+            Nova.SdlSource.FileDialogSession? session = ShowDialogLinuxCore(kind, BuildLinuxFilters(), allowMany);
+            if (session is null)
+            {
+                return false;
+            }
+
+            if (session.FilterIndex > 0)
+            {
+                FilterIndex = session.FilterIndex;
+            }
+
+            if (isSave)
+            {
+                ApplyLinuxSaveExtension();
+            }
+            else if (CheckFileExists && MutableItemNames is { } names)
+            {
+                // The Windows dialog refuses selections that don't exist; the portal may
+                // not. Mirror the managed contract: drop missing files, refuse when none
+                // remain.
+                string[] existing = Array.FindAll(names, File.Exists);
+                if (existing.Length == 0)
+                {
+                    MutableItemNames = null;
+                    return false;
+                }
+
+                MutableItemNames = existing;
+            }
+
+            return true;
+        }
+
+        /// <summary>Maps the WPF Filter string ("Label|*.ext1;*.ext2|...") to SDL filters.</summary>
+        private Nova.SdlSource.FileDialogFilter[]? BuildLinuxFilters()
+        {
+            if (string.IsNullOrEmpty(Filter))
+            {
+                return null;
+            }
+
+            // "Label|pattern|Label|pattern" — an unpaired trailing label is ignored.
+            string[] parts = Filter.Split('|');
+            var filters = new List<Nova.SdlSource.FileDialogFilter>();
+            for (int i = 0; i + 1 < parts.Length; i += 2)
+            {
+                filters.Add(new Nova.SdlSource.FileDialogFilter(parts[i], ToSdlPattern(parts[i + 1])));
+            }
+
+            return filters.Count == 0 ? null : [.. filters];
+        }
+
+        /// <summary>"*.jpg;*.jpeg" -> "jpg;jpeg"; "*" / "*.*" -> "*" (SDL rejects the "*." form).</summary>
+        private static string ToSdlPattern(string pattern)
+        {
+            var extensions = new List<string>();
+            foreach (string part in pattern.Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
+            {
+                string extension = part.TrimStart('*', '.');
+                extensions.Add(extension.Length == 0 ? "*" : extension);
+            }
+
+            return string.Join(';', extensions);
+        }
+
+        /// <summary>The Windows save dialog appends DefaultExt when the user typed none.</summary>
+        private void ApplyLinuxSaveExtension()
+        {
+            if (!AddExtension || DefaultExt.Length == 0 || MutableItemNames is not [string name])
+            {
+                return;
+            }
+
+            if (Path.GetExtension(name).Length == 0)
+            {
+                string extension = DefaultExt.StartsWith('.') ? DefaultExt : "." + DefaultExt;
+                MutableItemNames = [name + extension];
+            }
+        }
+
