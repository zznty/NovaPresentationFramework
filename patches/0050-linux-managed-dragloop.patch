+        internal static Func<DependencyObject, IDataObject, DragDropEffects, DragDropEffects>? LinuxDragLoop;
 
+        // Linux (patch 0050): the intra-app drag loop is fully managed. The OLE
+        // DoDragDrop exists only because Windows hosts the drag in ole32; nothing
+        // in the routed-event contract needs OLE. The loop lives in Nova.SdlSource;
+        // the payload is wrapped in an OLE-free ManagedDataObject because the OLE
+        // DataObject's construction JIT-resolves System.Private.Windows.Core.
+        private static DragDropEffects DoDragDropLinux(DependencyObject dragSource, object data, DragDropEffects allowedEffects)
+        {
+            ArgumentNullException.ThrowIfNull(dragSource);
+            ArgumentNullException.ThrowIfNull(data);
+
