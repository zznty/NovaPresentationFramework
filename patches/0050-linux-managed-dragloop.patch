+    /// <summary>
+    /// A managed, OLE-free <see cref="IDataObject"/> wrapping the payload an
+    /// application passed to <see cref="DragDrop.DoDragDrop"/>. Serves the text
+    /// and file-list formats the managed drag loop can carry; the OLE DataObject
+    /// (System.Private.Windows.Core) has no Linux host.
+    /// </summary>
+    internal sealed class ManagedDataObject : IDataObject
+    {
+        private readonly object _payload;
+
+        internal ManagedDataObject(object payload)
+        {
+            _payload = payload;
+        }
+
+        public object? GetData(string format)
+        {
+            return _payload is string text && IsTextFormat(format)
+                ? text
+                : _payload is string[] files && format == DataFormats.FileDrop
+                    ? files
+                    : null;
+        }
+
+        public object? GetData(string format, bool autoConvert)
+        {
+            _ = autoConvert;
+            return GetData(format);
+        }
+
+        public object? GetData(Type format)
+        {
+            return _payload is string text && format == typeof(string)
+                ? text
+                : _payload is string[] files && format == typeof(string[])
+                    ? files
+                    : null;
+        }
+
+        public bool GetDataPresent(string format)
+        {
+            return _payload is string && IsTextFormat(format) || _payload is string[] && format == DataFormats.FileDrop;
+        }
+
+        public bool GetDataPresent(string format, bool autoConvert)
+        {
+            _ = autoConvert;
+            return GetDataPresent(format);
+        }
+
+        public bool GetDataPresent(Type format)
+        {
+            return _payload is string && format == typeof(string) || _payload is string[] && format == typeof(string[]);
+        }
+
+        public string[] GetFormats()
+        {
+            return _payload is string
+                ? [DataFormats.UnicodeText]
+                : _payload is string[]
+                    ? [DataFormats.FileDrop]
+                    : [];
+        }
+
+        public string[] GetFormats(bool autoConvert)
+        {
+            _ = autoConvert;
+            return GetFormats();
+        }
+
+        public void SetData(object data)
+        {
+        }
+
+        public void SetData(string format, object data)
+        {
+        }
+
+        public void SetData(Type format, object data)
+        {
+        }
+
+        public void SetData(string format, object data, bool autoConvert)
+        {
+        }
+
+        private static bool IsTextFormat(string format)
+        {
+            return format == DataFormats.Text || format == DataFormats.UnicodeText || format == DataFormats.StringFormat;
+        }
+    }
