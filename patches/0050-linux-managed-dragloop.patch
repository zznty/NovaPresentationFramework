+            RaiseDragDropLifecycleEvent(dragSource, DragDropCompletedEvent);
+            return result;
+        }
+
+        private static void RaiseDragDropLifecycleEvent(DependencyObject source, RoutedEvent routedEvent)
+        {
+            var args = new RoutedEventArgs(routedEvent, source);
+            if (source is UIElement uiElement)
+            {
+                uiElement.RaiseEvent(args);
+            }
+            else if (source is ContentElement contentElement)
+            {
+                contentElement.RaiseEvent(args);
+            }
+            else if (source is UIElement3D uiElement3D)
+            {
+                uiElement3D.RaiseEvent(args);
+            }
         }
 
