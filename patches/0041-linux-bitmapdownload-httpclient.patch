+        /// <summary>
+        ///  The SDL-runtime download path: the body is streamed with HttpClient
+        ///  (GetStreamAsync — the response is not buffered; it returns after the headers)
+        ///  into the managed delete-on-close temp file created in BeginDownload. Redirects
+        ///  are followed: the Win32 path goes through HttpWebRequest, whose
+        ///  AllowAutoRedirect defaults to true and is never overridden in
+        ///  WpfWebRequestHelper, and SocketsHttpHandler defaults match (50 hops). The
+        ///  uriCachePolicy is a WinInet-cache concept with no Linux counterpart and is
+        ///  ignored here.
+        /// </summary>
+        private static void BeginDownloadLinux(QueueEntry entry, Uri uri)
+        {
+            _ = Task.Run(async () =>
+            {
+                try
+                {
+                    entry.inputStream = await s_httpClient.GetStreamAsync(uri).ConfigureAwait(false);
+                    entry.contentLength = -1;
+                    entry.contentType = string.Empty;
+                    _workQueue.Enqueue(entry);
+                    _waitEvent.Set();
+                }
+                catch (Exception e)
+                {
+                    MarshalException(entry, e);
+                }
+            });
+        }
+
+        /// <summary>
+        ///  The shared HttpClient for the SDL-runtime download path. AllowAutoRedirect is
+        ///  explicit for the HttpWebRequest parity documented on
+        ///  <see cref="BeginDownloadLinux"/>; AutomaticDecompression stays off like
+        ///  HttpWebRequest (WPF never enables it); the timeout stays at the handler
+        ///  default (no overall cap), matching the stream-read semantics of the Win32
+        ///  path's ReadWriteTimeout window rather than cutting large downloads short.
+        /// </summary>
+        private static readonly HttpClient s_httpClient = new(new SocketsHttpHandler
+        {
+            AllowAutoRedirect = true,
+            AutomaticDecompression = DecompressionMethods.None,
+        });
+
