<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <Description>SDL PresentationSource and CompositionTarget.</Description>
    <RootNamespace>Nova.SdlSource</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nova.Host\Nova.Host.csproj" />
    <ProjectReference Include="..\Nova.Mil\Nova.Mil.csproj" />
    <ProjectReference Include="..\Nova.Sdl\Nova.Sdl.csproj" />
    <ProjectReference Include="..\Nova.Vulkan\Nova.Vulkan.csproj" />
    <ProjectReference Include="..\Nova.Geometry\Nova.Geometry.csproj" />
    <ProjectReference Include="..\..\third_party/dotnet-wpf/src/Microsoft.DotNet.Wpf/src/PresentationCore/PresentationCore.csproj" />
    <ProjectReference Include="..\..\third_party/dotnet-wpf/src/Microsoft.DotNet.Wpf/src/WindowsBase/WindowsBase.csproj" />
    <DefaultReferenceExclusion Include="WindowsBase" />
    <InternalsVisibleTo Include="Nova.SdlSource.Tests, " />
    <PackageReference Include="System.Configuration.ConfigurationManager" />
    <PackageReference Include="System.IO.Packaging" />
  </ItemGroup>
  <Target Name="FilterImplicitAssemblyReferences"
          AfterTargets="ResolveTargetingPackAssets"
          BeforeTargets="_HandlePackageFileConflicts;ResolveAssemblyReferences">
    <ItemGroup>
      <_referenceExclusion Include="@(DefaultReferenceExclusion)">
        <AssemblyName>%(DefaultReferenceExclusion.Identity)</AssemblyName>
        <ExternallyResolved>true</ExternallyResolved>
      </_referenceExclusion>
      <Reference Remove="@(_referenceExclusion)" MatchOnMetadata="AssemblyName;ExternallyResolved" />
    </ItemGroup>
  </Target>
</Project>
