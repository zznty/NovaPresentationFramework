<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:theme="clr-namespace:Nova.DesktopTheme.Host;assembly=Nova.DesktopTheme.Host"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- Metric fallbacks: the AdwaitaTheme bridge overwrites these from the parsed
         GTK theme (Adwaita defaults when none is installed). Templates read the
         DynamicResources so a live reload restyles in place. -->
    <Thickness x:Key="Adwaita.Button.Padding">8,4,8,4</Thickness>
    <Thickness x:Key="Adwaita.Entry.Padding">8,4,8,4</Thickness>
    <Thickness x:Key="Adwaita.MenuItem.Padding">10,6,10,6</Thickness>
    <SolidColorBrush x:Key="Adwaita.Button.Background" Color="#fafafa" />
    <SolidColorBrush x:Key="Adwaita.Button.BackgroundHover" Color="#ededed" />
    <SolidColorBrush x:Key="Adwaita.Button.BackgroundActive" Color="#dedede" />
    <SolidColorBrush x:Key="Adwaita.Button.Border" Color="#c0c0c0" />
    <SolidColorBrush x:Key="Adwaita.Button.Foreground" Color="#2e3436" />
    <SolidColorBrush x:Key="Adwaita.Accent.Background" Color="#3584e4" />
    <SolidColorBrush x:Key="Adwaita.Accent.Foreground" Color="#ffffff" />
    <SolidColorBrush x:Key="Adwaita.Entry.Background" Color="#ffffff" />
    <SolidColorBrush x:Key="Adwaita.View.Background" Color="#ffffff" />
    <SolidColorBrush x:Key="Adwaita.Window.Background" Color="#fafafa" />

    <Style TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Adwaita.FontSize}" />
        <Setter Property="FontFamily" Value="{DynamicResource Adwaita.FontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource Adwaita.Text.Foreground}" />
    </Style>

    <!-- Text inherits from its control: selected/highlighted states override
         the foreground per-state (e.g. theme_selected_fg_color); a TextBlock
         style setting Foreground would beat inheritance everywhere. -->
    <Style TargetType="Control">
        <Setter Property="Foreground" Value="{DynamicResource Adwaita.Text.Foreground}" />
    </Style>

    <Style x:Key="AdwaitaFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource Adwaita.Accent.Background}"
                            BorderThickness="2"
                            CornerRadius="{DynamicResource Adwaita.Button.Radius}"
                            Margin="-3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button -->
    <Style TargetType="Button">
        <Setter Property="Padding" Value="{DynamicResource Adwaita.Button.Padding}" />
        <Setter Property="MinHeight" Value="{DynamicResource Adwaita.Button.MinHeight}" />
        <Setter Property="Background" Value="{DynamicResource Adwaita.Button.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Adwaita.Button.Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Adwaita.Button.Border}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AdwaitaFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
<ControlTemplate TargetType="Button">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="MouseOver" GeneratedDuration="0:0:0">
                                        <VisualTransition.Storyboard>
                                                                                                            <Storyboard><ColorAnimation Storyboard.TargetName="root"
                                                                 Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                 Duration="{DynamicResource Adwaita.Animation.BorderDuration}"
                                                                To="{DynamicResource Adwaita.Button.BorderHoverColor}">
                                                <ColorAnimation.EasingFunction>
                                                    <theme:BezierEasingFunction X1="{DynamicResource Adwaita.Animation.EasingX1}"
                                                                                Y1="{DynamicResource Adwaita.Animation.EasingY1}"
                                                                                X2="{DynamicResource Adwaita.Animation.EasingX2}"
                                                                                Y2="{DynamicResource Adwaita.Animation.EasingY2}" />
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                                                <ColorAnimation Storyboard.TargetName="root"
                                                                 Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                 Duration="{DynamicResource Adwaita.Animation.FastDuration}"
                                                                To="{DynamicResource Adwaita.Button.BackgroundHoverColor}">
                                                <ColorAnimation.EasingFunction>
                                                    <theme:BezierEasingFunction X1="{DynamicResource Adwaita.Animation.EasingX1}"
                                                                                Y1="{DynamicResource Adwaita.Animation.EasingY1}"
                                                                                X2="{DynamicResource Adwaita.Animation.EasingX2}"
                                                                                Y2="{DynamicResource Adwaita.Animation.EasingY2}" />
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                                                                    </Storyboard>
                                                                                </VisualTransition.Storyboard>
                                    </VisualTransition>
                                    <VisualTransition From="MouseOver" To="Normal" GeneratedDuration="0:0:0">
                                        <VisualTransition.Storyboard>
                                                                                                            <Storyboard><ColorAnimation Storyboard.TargetName="root"
                                                                 Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                 Duration="{DynamicResource Adwaita.Animation.BorderDuration}"
                                                                To="{DynamicResource Adwaita.Button.BorderColor}">
                                                <ColorAnimation.EasingFunction>
                                                    <theme:BezierEasingFunction X1="{DynamicResource Adwaita.Animation.EasingX1}"
                                                                                Y1="{DynamicResource Adwaita.Animation.EasingY1}"
                                                                                X2="{DynamicResource Adwaita.Animation.EasingX2}"
                                                                                Y2="{DynamicResource Adwaita.Animation.EasingY2}" />
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                                                <ColorAnimation Storyboard.TargetName="root"
                                                                 Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                 Duration="{DynamicResource Adwaita.Animation.FastDuration}"
                                                                To="{DynamicResource Adwaita.Button.BackgroundColor}">
                                                <ColorAnimation.EasingFunction>
                                                    <theme:BezierEasingFunction X1="{DynamicResource Adwaita.Animation.EasingX1}"
                                                                                Y1="{DynamicResource Adwaita.Animation.EasingY1}"
                                                                                X2="{DynamicResource Adwaita.Animation.EasingX2}"
                                                                                Y2="{DynamicResource Adwaita.Animation.EasingY2}" />
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                                                                    </Storyboard>
                                                                                </VisualTransition.Storyboard>
                                    </VisualTransition>
                                    <VisualTransition To="Pressed" GeneratedDuration="0:0:0">
                                        <VisualTransition.Storyboard>
                                                                                                            <Storyboard><ColorAnimation Storyboard.TargetName="root"
                                                                 Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                 Duration="{DynamicResource Adwaita.Animation.BorderDuration}"
                                                                To="{DynamicResource Adwaita.Button.BorderHoverColor}">
                                                <ColorAnimation.EasingFunction>
                                                    <theme:BezierEasingFunction X1="{DynamicResource Adwaita.Animation.EasingX1}"
                                                                                Y1="{DynamicResource Adwaita.Animation.EasingY1}"
                                                                                X2="{DynamicResource Adwaita.Animation.EasingX2}"
                                                                                Y2="{DynamicResource Adwaita.Animation.EasingY2}" />
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                                                <ColorAnimation Storyboard.TargetName="root"
                                                                 Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                 Duration="{DynamicResource Adwaita.Animation.FastDuration}"
                                                                To="{DynamicResource Adwaita.Button.BackgroundActiveColor}">
                                                <ColorAnimation.EasingFunction>
                                                    <theme:BezierEasingFunction X1="{DynamicResource Adwaita.Animation.EasingX1}"
                                                                                Y1="{DynamicResource Adwaita.Animation.EasingY1}"
                                                                                X2="{DynamicResource Adwaita.Animation.EasingX2}"
                                                                                Y2="{DynamicResource Adwaita.Animation.EasingY2}" />
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                                                <ColorAnimation Storyboard.TargetName="ring"
                                                                 Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                 Duration="{DynamicResource Adwaita.Animation.BorderDuration}"
                                                                To="{DynamicResource Adwaita.Button.BorderHoverColor}">
                                                <ColorAnimation.EasingFunction>
                                                    <theme:BezierEasingFunction X1="{DynamicResource Adwaita.Animation.EasingX1}"
                                                                                Y1="{DynamicResource Adwaita.Animation.EasingY1}"
                                                                                X2="{DynamicResource Adwaita.Animation.EasingX2}"
                                                                                Y2="{DynamicResource Adwaita.Animation.EasingY2}" />
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                                                                    </Storyboard>
                                                                                </VisualTransition.Storyboard>
                                    </VisualTransition>
                                    <VisualTransition From="Pressed" To="Normal" GeneratedDuration="0:0:0">
                                        <VisualTransition.Storyboard>
                                                                                                            <Storyboard><ColorAnimation Storyboard.TargetName="root"
                                                                 Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                 Duration="{DynamicResource Adwaita.Animation.BorderDuration}"
                                                                To="{DynamicResource Adwaita.Button.BorderColor}">
                                                <ColorAnimation.EasingFunction>
                                                    <theme:BezierEasingFunction X1="{DynamicResource Adwaita.Animation.EasingX1}"
                                                                                Y1="{DynamicResource Adwaita.Animation.EasingY1}"
                                                                                X2="{DynamicResource Adwaita.Animation.EasingX2}"
                                                                                Y2="{DynamicResource Adwaita.Animation.EasingY2}" />
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                                                <ColorAnimation Storyboard.TargetName="root"
                                                                 Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                 Duration="{DynamicResource Adwaita.Animation.FastDuration}"
                                                                To="{DynamicResource Adwaita.Button.BackgroundColor}">
                                                <ColorAnimation.EasingFunction>
                                                    <theme:BezierEasingFunction X1="{DynamicResource Adwaita.Animation.EasingX1}"
                                                                                Y1="{DynamicResource Adwaita.Animation.EasingY1}"
                                                                                X2="{DynamicResource Adwaita.Animation.EasingX2}"
                                                                                Y2="{DynamicResource Adwaita.Animation.EasingY2}" />
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                                                <ColorAnimation Storyboard.TargetName="ring"
                                                                 Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                 Duration="{DynamicResource Adwaita.Animation.BorderDuration}"
                                                                To="{DynamicResource Transparent}">
                                                <ColorAnimation.EasingFunction>
                                                    <theme:BezierEasingFunction X1="{DynamicResource Adwaita.Animation.EasingX1}"
                                                                                Y1="{DynamicResource Adwaita.Animation.EasingY1}"
                                                                                X2="{DynamicResource Adwaita.Animation.EasingX2}"
                                                                                Y2="{DynamicResource Adwaita.Animation.EasingY2}" />
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                                                                    </Storyboard>
                                                                                </VisualTransition.Storyboard>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="root"
                                                                             Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                             To="{DynamicResource Adwaita.Button.BorderColor}"
                                                                             Duration="0" />
                                                <ColorAnimation Storyboard.TargetName="root"
                                                                             Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                             To="{DynamicResource Adwaita.Button.BackgroundColor}"
                                                                             Duration="0" />
                                        <ColorAnimation Storyboard.TargetName="ring"
                                                                             Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                             To="{DynamicResource Transparent}"
                                                                             Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="root"
                                                                             Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                             To="{DynamicResource Adwaita.Button.BorderHoverColor}"
                                                                             Duration="0" />
                                                <ColorAnimation Storyboard.TargetName="root"
                                                                             Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                             To="{DynamicResource Adwaita.Button.BackgroundHoverColor}"
                                                                             Duration="0" />
                                        <ColorAnimation Storyboard.TargetName="ring"
                                                                             Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                             To="{DynamicResource Transparent}"
                                                                             Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="root"
                                                                             Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                             To="{DynamicResource Adwaita.Button.BorderHoverColor}"
                                                                             Duration="0" />
                                                <ColorAnimation Storyboard.TargetName="root"
                                                                             Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                             To="{DynamicResource Adwaita.Button.BackgroundHoverColor}"
                                                                             Duration="0" />
                                                <ColorAnimation Storyboard.TargetName="ring"
                                                                             Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                             To="{DynamicResource Adwaita.Button.BorderHoverColor}"
                                                                             Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="root"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Adwaita.Button.Radius}"
                                Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <SolidColorBrush po:Freeze="False" Color="{DynamicResource Adwaita.Button.BackgroundColor}" />
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush po:Freeze="False" Color="{DynamicResource Adwaita.Button.BorderColor}" />
                            </Border.BorderBrush>
                            <Grid>
                                <Border x:Name="ring"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Adwaita.Button.Radius}"
                                        Margin="1"
                                        IsHitTestVisible="False" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToggleButton -->
    <Style TargetType="ToggleButton">
        <Setter Property="Padding" Value="{DynamicResource Adwaita.Button.Padding}" />
        <Setter Property="MinHeight" Value="{DynamicResource Adwaita.Button.MinHeight}" />
        <Setter Property="Background" Value="{DynamicResource Adwaita.Button.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Adwaita.Button.Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Adwaita.Button.Border}" />
        <Setter Property="Template">
            <Setter.Value>
<ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="MouseOver" GeneratedDuration="0:0:0">
                                        <VisualTransition.Storyboard>
                                                                                                            <Storyboard><ColorAnimation Storyboard.TargetName="root"
                                                                 Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                 Duration="{DynamicResource Adwaita.Animation.BorderDuration}"
                                                                To="{DynamicResource Adwaita.Button.BorderHoverColor}">
                                                <ColorAnimation.EasingFunction>
                                                    <theme:BezierEasingFunction X1="{DynamicResource Adwaita.Animation.EasingX1}"
                                                                                Y1="{DynamicResource Adwaita.Animation.EasingY1}"
                                                                                X2="{DynamicResource Adwaita.Animation.EasingX2}"
                                                                                Y2="{DynamicResource Adwaita.Animation.EasingY2}" />
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                                                <ColorAnimation Storyboard.TargetName="root"
                                                                 Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                 Duration="{DynamicResource Adwaita.Animation.FastDuration}"
                                                                To="{DynamicResource Adwaita.Button.BackgroundHoverColor}">
                                                <ColorAnimation.EasingFunction>
                                                    <theme:BezierEasingFunction X1="{DynamicResource Adwaita.Animation.EasingX1}"
                                                                                Y1="{DynamicResource Adwaita.Animation.EasingY1}"
                                                                                X2="{DynamicResource Adwaita.Animation.EasingX2}"
                                                                                Y2="{DynamicResource Adwaita.Animation.EasingY2}" />
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                                                                    </Storyboard>
                                                                                </VisualTransition.Storyboard>
                                    </VisualTransition>
                                    <VisualTransition From="MouseOver" To="Normal" GeneratedDuration="0:0:0">
                                        <VisualTransition.Storyboard>
                                                                                                            <Storyboard><ColorAnimation Storyboard.TargetName="root"
                                                                 Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                 Duration="{DynamicResource Adwaita.Animation.BorderDuration}"
                                                                To="{DynamicResource Adwaita.Button.BorderColor}">
                                                <ColorAnimation.EasingFunction>
                                                    <theme:BezierEasingFunction X1="{DynamicResource Adwaita.Animation.EasingX1}"
                                                                                Y1="{DynamicResource Adwaita.Animation.EasingY1}"
                                                                                X2="{DynamicResource Adwaita.Animation.EasingX2}"
                                                                                Y2="{DynamicResource Adwaita.Animation.EasingY2}" />
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                                                <ColorAnimation Storyboard.TargetName="root"
                                                                 Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                 Duration="{DynamicResource Adwaita.Animation.FastDuration}"
                                                                To="{DynamicResource Adwaita.Button.BackgroundColor}">
                                                <ColorAnimation.EasingFunction>
                                                    <theme:BezierEasingFunction X1="{DynamicResource Adwaita.Animation.EasingX1}"
                                                                                Y1="{DynamicResource Adwaita.Animation.EasingY1}"
                                                                                X2="{DynamicResource Adwaita.Animation.EasingX2}"
                                                                                Y2="{DynamicResource Adwaita.Animation.EasingY2}" />
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                                                                    </Storyboard>
                                                                                </VisualTransition.Storyboard>
                                    </VisualTransition>
                                    <VisualTransition To="Pressed" GeneratedDuration="0:0:0">
                                        <VisualTransition.Storyboard>
                                                                                                            <Storyboard><ColorAnimation Storyboard.TargetName="root"
                                                                 Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                 Duration="{DynamicResource Adwaita.Animation.BorderDuration}"
                                                                To="{DynamicResource Adwaita.Button.BorderHoverColor}">
                                                <ColorAnimation.EasingFunction>
                                                    <theme:BezierEasingFunction X1="{DynamicResource Adwaita.Animation.EasingX1}"
                                                                                Y1="{DynamicResource Adwaita.Animation.EasingY1}"
                                                                                X2="{DynamicResource Adwaita.Animation.EasingX2}"
                                                                                Y2="{DynamicResource Adwaita.Animation.EasingY2}" />
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                                                <ColorAnimation Storyboard.TargetName="root"
                                                                 Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                 Duration="{DynamicResource Adwaita.Animation.FastDuration}"
                                                                To="{DynamicResource Adwaita.Button.BackgroundActiveColor}">
                                                <ColorAnimation.EasingFunction>
                                                    <theme:BezierEasingFunction X1="{DynamicResource Adwaita.Animation.EasingX1}"
                                                                                Y1="{DynamicResource Adwaita.Animation.EasingY1}"
                                                                                X2="{DynamicResource Adwaita.Animation.EasingX2}"
                                                                                Y2="{DynamicResource Adwaita.Animation.EasingY2}" />
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                                                <ColorAnimation Storyboard.TargetName="ring"
                                                                 Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                 Duration="{DynamicResource Adwaita.Animation.BorderDuration}"
                                                                To="{DynamicResource Adwaita.Button.BorderHoverColor}">
                                                <ColorAnimation.EasingFunction>
                                                    <theme:BezierEasingFunction X1="{DynamicResource Adwaita.Animation.EasingX1}"
                                                                                Y1="{DynamicResource Adwaita.Animation.EasingY1}"
                                                                                X2="{DynamicResource Adwaita.Animation.EasingX2}"
                                                                                Y2="{DynamicResource Adwaita.Animation.EasingY2}" />
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                                                                    </Storyboard>
                                                                                </VisualTransition.Storyboard>
                                    </VisualTransition>
                                    <VisualTransition From="Pressed" To="Normal" GeneratedDuration="0:0:0">
                                        <VisualTransition.Storyboard>
                                                                                                            <Storyboard><ColorAnimation Storyboard.TargetName="root"
                                                                 Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                 Duration="{DynamicResource Adwaita.Animation.BorderDuration}"
                                                                To="{DynamicResource Adwaita.Button.BorderColor}">
                                                <ColorAnimation.EasingFunction>
                                                    <theme:BezierEasingFunction X1="{DynamicResource Adwaita.Animation.EasingX1}"
                                                                                Y1="{DynamicResource Adwaita.Animation.EasingY1}"
                                                                                X2="{DynamicResource Adwaita.Animation.EasingX2}"
                                                                                Y2="{DynamicResource Adwaita.Animation.EasingY2}" />
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                                                <ColorAnimation Storyboard.TargetName="root"
                                                                 Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                 Duration="{DynamicResource Adwaita.Animation.FastDuration}"
                                                                To="{DynamicResource Adwaita.Button.BackgroundColor}">
                                                <ColorAnimation.EasingFunction>
                                                    <theme:BezierEasingFunction X1="{DynamicResource Adwaita.Animation.EasingX1}"
                                                                                Y1="{DynamicResource Adwaita.Animation.EasingY1}"
                                                                                X2="{DynamicResource Adwaita.Animation.EasingX2}"
                                                                                Y2="{DynamicResource Adwaita.Animation.EasingY2}" />
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                                                <ColorAnimation Storyboard.TargetName="ring"
                                                                 Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                 Duration="{DynamicResource Adwaita.Animation.BorderDuration}"
                                                                To="{DynamicResource Transparent}">
                                                <ColorAnimation.EasingFunction>
                                                    <theme:BezierEasingFunction X1="{DynamicResource Adwaita.Animation.EasingX1}"
                                                                                Y1="{DynamicResource Adwaita.Animation.EasingY1}"
                                                                                X2="{DynamicResource Adwaita.Animation.EasingX2}"
                                                                                Y2="{DynamicResource Adwaita.Animation.EasingY2}" />
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                                                                    </Storyboard>
                                                                                </VisualTransition.Storyboard>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="root"
                                                                             Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                             To="{DynamicResource Adwaita.Button.BorderColor}"
                                                                             Duration="0" />
                                                <ColorAnimation Storyboard.TargetName="root"
                                                                             Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                             To="{DynamicResource Adwaita.Button.BackgroundColor}"
                                                                             Duration="0" />
                                        <ColorAnimation Storyboard.TargetName="ring"
                                                                             Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                             To="{DynamicResource Transparent}"
                                                                             Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="root"
                                                                             Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                             To="{DynamicResource Adwaita.Button.BorderHoverColor}"
                                                                             Duration="0" />
                                                <ColorAnimation Storyboard.TargetName="root"
                                                                             Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                             To="{DynamicResource Adwaita.Button.BackgroundHoverColor}"
                                                                             Duration="0" />
                                        <ColorAnimation Storyboard.TargetName="ring"
                                                                             Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                             To="{DynamicResource Transparent}"
                                                                             Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="root"
                                                                             Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                             To="{DynamicResource Adwaita.Button.BorderHoverColor}"
                                                                             Duration="0" />
                                                <ColorAnimation Storyboard.TargetName="root"
                                                                             Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                             To="{DynamicResource Adwaita.Button.BackgroundHoverColor}"
                                                                             Duration="0" />
                                                <ColorAnimation Storyboard.TargetName="ring"
                                                                             Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                             To="{DynamicResource Adwaita.Button.BorderHoverColor}"
                                                                             Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="Checked" GeneratedDuration="0:0:0">
                                        <VisualTransition.Storyboard>
                                                                                                            <Storyboard><ColorAnimation Storyboard.TargetName="root"
                                                                 Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                 Duration="{DynamicResource Adwaita.Animation.FastDuration}"
                                                                To="{DynamicResource Adwaita.Selected.BackgroundColor}">
                                                <ColorAnimation.EasingFunction>
                                                    <theme:BezierEasingFunction X1="{DynamicResource Adwaita.Animation.EasingX1}"
                                                                                Y1="{DynamicResource Adwaita.Animation.EasingY1}"
                                                                                X2="{DynamicResource Adwaita.Animation.EasingX2}"
                                                                                Y2="{DynamicResource Adwaita.Animation.EasingY2}" />
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                                                <ColorAnimation Storyboard.TargetName="root"
                                                                 Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                 Duration="{DynamicResource Adwaita.Animation.BorderDuration}"
                                                                To="{DynamicResource Adwaita.Selected.BackgroundColor}">
                                                <ColorAnimation.EasingFunction>
                                                    <theme:BezierEasingFunction X1="{DynamicResource Adwaita.Animation.EasingX1}"
                                                                                Y1="{DynamicResource Adwaita.Animation.EasingY1}"
                                                                                X2="{DynamicResource Adwaita.Animation.EasingX2}"
                                                                                Y2="{DynamicResource Adwaita.Animation.EasingY2}" />
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                                                <ColorAnimation Storyboard.TargetName="content"
                                                                 Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)"
                                                                 Duration="{DynamicResource Adwaita.Animation.FastDuration}"
                                                                To="{DynamicResource Adwaita.Selected.ForegroundColor}">
                                                <ColorAnimation.EasingFunction>
                                                    <theme:BezierEasingFunction X1="{DynamicResource Adwaita.Animation.EasingX1}"
                                                                                Y1="{DynamicResource Adwaita.Animation.EasingY1}"
                                                                                X2="{DynamicResource Adwaita.Animation.EasingX2}"
                                                                                Y2="{DynamicResource Adwaita.Animation.EasingY2}" />
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                                                                    </Storyboard>
                                                                                </VisualTransition.Storyboard>
                                    </VisualTransition>
                                    <VisualTransition From="Checked" To="Unchecked" GeneratedDuration="0:0:0">
                                        <VisualTransition.Storyboard>
                                                                                                            <Storyboard><ColorAnimation Storyboard.TargetName="root"
                                                                 Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                 Duration="{DynamicResource Adwaita.Animation.FastDuration}"
                                                                To="{DynamicResource Adwaita.Button.BackgroundColor}">
                                                <ColorAnimation.EasingFunction>
                                                    <theme:BezierEasingFunction X1="{DynamicResource Adwaita.Animation.EasingX1}"
                                                                                Y1="{DynamicResource Adwaita.Animation.EasingY1}"
                                                                                X2="{DynamicResource Adwaita.Animation.EasingX2}"
                                                                                Y2="{DynamicResource Adwaita.Animation.EasingY2}" />
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                                                <ColorAnimation Storyboard.TargetName="root"
                                                                 Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                 Duration="{DynamicResource Adwaita.Animation.BorderDuration}"
                                                                To="{DynamicResource Adwaita.Button.BorderColor}">
                                                <ColorAnimation.EasingFunction>
                                                    <theme:BezierEasingFunction X1="{DynamicResource Adwaita.Animation.EasingX1}"
                                                                                Y1="{DynamicResource Adwaita.Animation.EasingY1}"
                                                                                X2="{DynamicResource Adwaita.Animation.EasingX2}"
                                                                                Y2="{DynamicResource Adwaita.Animation.EasingY2}" />
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                                                <ColorAnimation Storyboard.TargetName="content"
                                                                 Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)"
                                                                 Duration="{DynamicResource Adwaita.Animation.FastDuration}"
                                                                To="{DynamicResource Adwaita.Button.ForegroundColor}">
                                                <ColorAnimation.EasingFunction>
                                                    <theme:BezierEasingFunction X1="{DynamicResource Adwaita.Animation.EasingX1}"
                                                                                Y1="{DynamicResource Adwaita.Animation.EasingY1}"
                                                                                X2="{DynamicResource Adwaita.Animation.EasingX2}"
                                                                                Y2="{DynamicResource Adwaita.Animation.EasingY2}" />
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                                                                    </Storyboard>
                                                                                </VisualTransition.Storyboard>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Unchecked">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="root"
                                                                             Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                             To="{DynamicResource Adwaita.Button.BackgroundColor}"
                                                                             Duration="0" />
                                                <ColorAnimation Storyboard.TargetName="root"
                                                                             Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                             To="{DynamicResource Adwaita.Button.BorderColor}"
                                                                             Duration="0" />
                                                <ColorAnimation Storyboard.TargetName="content"
                                                                             Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)"
                                                                             To="{DynamicResource Adwaita.Button.ForegroundColor}"
                                                                             Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="root"
                                                                             Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                             To="{DynamicResource Adwaita.Selected.BackgroundColor}"
                                                                             Duration="0" />
                                                <ColorAnimation Storyboard.TargetName="root"
                                                                             Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                             To="{DynamicResource Adwaita.Selected.BackgroundColor}"
                                                                             Duration="0" />
                                                <ColorAnimation Storyboard.TargetName="content"
                                                                             Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)"
                                                                             To="{DynamicResource Adwaita.Selected.ForegroundColor}"
                                                                             Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="root"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Adwaita.Button.Radius}"
                                Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <SolidColorBrush po:Freeze="False" Color="{DynamicResource Adwaita.Button.BackgroundColor}" />
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush po:Freeze="False" Color="{DynamicResource Adwaita.Button.BorderColor}" />
                            </Border.BorderBrush>
                            <Grid>
                                <Border x:Name="ring"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Adwaita.Button.Radius}"
                                        Margin="1"
                                        IsHitTestVisible="False" />
                                <ContentPresenter x:Name="content"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CheckBox -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Adwaita.Button.Foreground}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AdwaitaFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box"
                                Width="16" Height="16"
                                Background="{DynamicResource Adwaita.Entry.Background}"
                                BorderBrush="{DynamicResource Adwaita.Button.Border}"
                                BorderThickness="1"
                                CornerRadius="3"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0">
                            <Path x:Name="check"
                                  Data="M 2.8 8.2 L 6.8 12.2 L 13.2 4.6"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Stroke="{DynamicResource Adwaita.Accent.Background}"
                                  StrokeThickness="2.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource Adwaita.Button.BackgroundHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="box" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RadioButton -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Adwaita.Button.Foreground}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AdwaitaFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Ellipse x:Name="outer"
                                     Fill="{DynamicResource Adwaita.Entry.Background}"
                                     Stroke="{DynamicResource Adwaita.Button.Border}"
                                     StrokeThickness="1" />
                            <Ellipse x:Name="dot"
                                     Width="8" Height="8"
                                     Fill="{DynamicResource Adwaita.Selected.Foreground}"
                                     Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="outer" Property="Fill" Value="{DynamicResource Adwaita.Selected.Background}" />
                            <Setter TargetName="outer" Property="Stroke" Value="{DynamicResource Adwaita.Selected.Background}" />
                            <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="outer" Property="Stroke" Value="{DynamicResource Adwaita.Button.BorderHover}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="outer" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextBox -->
    <Style TargetType="TextBox">
        <!-- TextBoxBase forwards VerticalContentAlignment to the view's
             alignment; the ScrollViewer stretches the view to the viewport, so
             this is what actually centers the text vertically. -->
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="{DynamicResource Adwaita.Entry.Padding}" />
        <Setter Property="MinHeight" Value="{DynamicResource Adwaita.Entry.MinHeight}" />
        <Setter Property="Height" Value="{DynamicResource Adwaita.Entry.MinHeight}" />
        <Setter Property="Background" Value="{DynamicResource Adwaita.Entry.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Adwaita.Button.Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Adwaita.Button.Border}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Adwaita.Entry.Radius}"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="root" Property="BorderBrush" Value="{DynamicResource Adwaita.Accent.Background}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox -->
    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="{DynamicResource Adwaita.Entry.Padding}" />
        <Setter Property="MinHeight" Value="{DynamicResource Adwaita.Entry.MinHeight}" />
        <Setter Property="Background" Value="{DynamicResource Adwaita.Button.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Adwaita.Button.Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Adwaita.Button.Border}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Adwaita.Entry.Radius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                        </Border>
                        <ToggleButton Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Background="Transparent"
                                      BorderThickness="0">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="None">
                            <Border Background="{DynamicResource Adwaita.View.Background}"
                                    BorderBrush="{DynamicResource Adwaita.Button.Border}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Adwaita.Menu.Radius}"
                                    Padding="4"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    Margin="0,2,0,0">
                                <ScrollViewer MaxHeight="260">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="root" Property="Background" Value="{DynamicResource Adwaita.Button.BackgroundHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBoxItem -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="{DynamicResource Adwaita.MenuItem.Padding}" />
        <Setter Property="Foreground" Value="{DynamicResource Adwaita.Button.Foreground}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="root"
                            Background="Transparent"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="content"
                                          TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="root" Property="Background" Value="{DynamicResource Adwaita.Selected.Background}" />
                            <Setter Property="Foreground" Value="{DynamicResource Adwaita.Selected.Foreground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ScrollBar -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="{DynamicResource Adwaita.ScrollBar.Thickness}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource Adwaita.Button.Border}"
                                                    CornerRadius="6"
                                                    Margin="2"
                                                    MinHeight="40" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="{DynamicResource Adwaita.ScrollBar.Thickness}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ProgressBar -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Adwaita.Accent.Background}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{DynamicResource Adwaita.Button.BackgroundActive}"
                                CornerRadius="4" />
                        <Border x:Name="PART_Indicator"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="4"
                                HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider -->
    <Style TargetType="Slider">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="{DynamicResource Adwaita.Scale.Fill}" Height="6" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Background="{DynamicResource Adwaita.Scale.Trough}" Height="6" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="22" Height="22" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Ellipse Fill="{DynamicResource Adwaita.Scale.Thumb}" />
                                                <Ellipse Width="10" Height="10" Fill="{DynamicResource Adwaita.Window.Background}" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TabControl / TabItem -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource Adwaita.Window.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Adwaita.Button.Border}" />
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Padding" Value="{DynamicResource Adwaita.TabItem.Padding}" />
        <Setter Property="Foreground" Value="{DynamicResource Adwaita.Button.Foreground}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="root"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1,1,1,0"
                            CornerRadius="6,6,0,0"
                            Padding="{TemplateBinding Padding}"
                            Margin="0,0,2,0">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource Adwaita.Text.Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="root" Property="Background" Value="{DynamicResource Adwaita.View.Background}" />
                            <Setter TargetName="root" Property="BorderBrush" Value="{DynamicResource Adwaita.Button.Border}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="root" Property="Background" Value="{DynamicResource Adwaita.Button.BackgroundHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menu -->
    <Style TargetType="Menu">
        <Setter Property="Background" Value="{DynamicResource Adwaita.Window.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Adwaita.Button.Foreground}" />
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Padding" Value="{DynamicResource Adwaita.MenuItem.Padding}" />
        <Setter Property="MinHeight" Value="{DynamicResource Adwaita.MenuItem.MinHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource Adwaita.Button.Foreground}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="root"
                            Background="Transparent"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="Icon"
                                              ContentSource="Icon"
                                              MinWidth="16"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                            <ContentPresenter x:Name="header" Grid.Column="1"
                                              ContentSource="Header"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <TextBlock Grid.Column="2"
                                       Text="{TemplateBinding InputGestureText}"
                                       VerticalAlignment="Center"
                                       Margin="16,0,0,0"
                                       Opacity="0.7" />
                            <Path Grid.Column="3"
                                  x:Name="arrow"
                                  Data="M 0 0 L 4 4 L 0 8"
                                  Width="6"
                                  Height="8"
                                  Stretch="Uniform"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Margin="10,0,4,0"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed" />
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Right"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="None">
                                <Border Background="{DynamicResource Adwaita.View.Background}"
                                        BorderBrush="{DynamicResource Adwaita.Button.Border}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Adwaita.Menu.Radius}"
                                        Padding="4"
                                        Margin="2,0,0,0"
                                        MinWidth="180">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom" />
                            <Setter TargetName="PART_Popup" Property="HorizontalOffset" Value="-7" />
                            <Setter TargetName="PART_Popup" Property="VerticalOffset" Value="2" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="root" Property="Background" Value="{DynamicResource Adwaita.Selected.Background}" />
                            <Setter Property="Foreground" Value="{DynamicResource Adwaita.Selected.Foreground}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Separator (menu) -->
    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1"
                            HorizontalAlignment="Stretch"
                            Background="{DynamicResource Adwaita.Separator.Color}"
                            Margin="0,3,0,3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- GroupBox -->
    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource Adwaita.Button.Foreground}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.RowSpan="2"
                                BorderBrush="{DynamicResource Adwaita.Button.Border}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,8,0,0" />
                        <Border Grid.Row="0"
                                Background="{DynamicResource Adwaita.Window.Background}"
                                Padding="8,0"
                                Margin="12,0,0,0"
                                HorizontalAlignment="Left">
                            <ContentPresenter ContentSource="Header" TextElement.Foreground="{DynamicResource Adwaita.Text.Foreground}" />
                        </Border>
                        <ContentPresenter Grid.Row="1" Margin="8" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
