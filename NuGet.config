<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
        <add key="zznty" value="https://ng.zznty.ru/v3/index.json" protocolVersion="3" />
        <add key="SilkGitlab" value="https://gitlab.com/api/v4/projects/51457475/packages/nuget/index.json" protocolVersion="3" />
        <add key="dotnet-eng" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-eng/nuget/v3/index.json" protocolVersion="3" />
        <add key="dotnet11" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet11/nuget/v3/index.json" protocolVersion="3" />
    </packageSources>
    <packageSourceMapping>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
        <packageSource key="zznty">
            <package pattern="SixLabors.ImageSharp" />
        </packageSource>
        <packageSource key="SilkGitlab">
            <package pattern="Silk.NET.*" />
        </packageSource>
        <packageSource key="dotnet-eng">
            <package pattern="Microsoft.DotNet.Arcade.*" />
        </packageSource>
        <packageSource key="dotnet11">
            <!-- The System.* 11.0.0-rc.1.26411.119 builds exist only on the
                 dnceng dotnet11 feed (nuget.org's nearest is preview.7 and
                 dotnet-eng has only preview.6); the specific patterns beat
                 the nuget.org wildcard. -->
            <package pattern="System.Configuration.ConfigurationManager" />
            <package pattern="System.Diagnostics.EventLog" />
            <package pattern="System.IO.Packaging" />
            <package pattern="System.Security.Cryptography.ProtectedData" />
            <package pattern="System.Windows.Extensions" />
        </packageSource>
    </packageSourceMapping>
</configuration>
