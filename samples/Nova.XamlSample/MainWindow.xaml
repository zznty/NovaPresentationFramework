<Window x:Class="Nova.XamlSample.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Nova.XamlSample"
        x:Uid="MainWindow"
        Title="MainWindow" Width="520" Height="380"
        Loaded="OnLoaded">
  <DockPanel x:Uid="RootDock">
    <Border x:Uid="HeaderBorder" DockPanel.Dock="Top" Background="{StaticResource AccentBrush}" Padding="8">
      <TextBlock x:Uid="TitleTextBlock" x:Name="TitleText" Text="WPF on Linux" Foreground="White" FontSize="18" />
    </Border>

    <StackPanel x:Uid="BodyStack" Margin="12">
      <!-- Area 2: ControlTemplate — a Button restyled with a custom template
           (Border chrome + ContentPresenter). -->
      <Button x:Uid="TemplatedButton" x:Name="TemplatedButton" Width="180" Height="36" Content="Templated Button"
              HorizontalAlignment="Left"
              Background="#FFDDEEFF" BorderBrush="Gray">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="10,4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Button.Template>
      </Button>

      <!-- Area 3: framework attached properties — Grid.Row/Column, Canvas.Left/Top,
           DockPanel.Dock — plus a consumer-defined attached property (local:Tracked). -->
      <Grid x:Uid="AttachedGrid" Margin="0,12,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Canvas x:Uid="CanvasRect" Grid.Row="0" Grid.Column="0" x:Name="CanvasRect" Width="120" Height="40" Background="LightGray">
          <Rectangle Canvas.Left="10" Canvas.Top="10" Width="20" Height="20" Fill="Red" />
          <Rectangle Canvas.Left="60" Canvas.Top="10" Width="20" Height="20" Fill="Blue" />
        </Canvas>

        <TextBlock x:Uid="AttachedText" Grid.Row="0" Grid.Column="1"
                   x:Name="AttachedText"
                   local:Tracked.Mark="area3-custom-attached"
                   Text="attached-props" VerticalAlignment="Center" Margin="12,0,0,0" />
      </Grid>

      <!-- Area 2: DataTemplate bound to a collection. -->
      <ItemsControl x:Uid="ItemList" x:Name="ItemList" Margin="0,12,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <Rectangle Width="12" Height="12" Fill="{Binding Color}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Label}" Margin="6,0,0,0" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </DockPanel>
</Window>
